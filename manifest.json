  "apiKeys": [
    {
      "id": "firecrawl",
      "label": "Firecrawl",
      "prompt": "Set up Firecrawl API key? (used by firecrawl-search extension)",
      "defaultNo": true,
      "write": {
        "type": "env",
        "variable": "FIRECRAWL_API_KEY"
      }
    },
    {
      "id": "context7",
      "label": "Context7",
      "prompt": "Set up Context7 MCP API key? (documentation lookup)",
      "defaultNo": true,
      "write": {
        "type": "mcp",
        "serverId": "context7",
        "url": "https://mcp.context7.com/mcp",
        "headerKey": "CONTEXT7_API_KEY"
      }
    },
    {
      "id": "opencode-go",
      "label": "OpenCode-Go",
      "prompt": "Set up OpenCode-Go API key? (default provider in this setup)",
      "defaultNo": true,
      "write": {
        "type": "auth",
        "providerId": "opencode-go",
        "authType": "api_key"
      }
    }
  ],
  "packages": [
    "@dreki-gg/pi-questionnaire",
    "@tintinweb/pi-subagents",
    "@dreki-gg/pi-plan-mode"
  ],
  "bunInstallDirs": [
    ".",
    "extensions/pi-mcp"
  ]
